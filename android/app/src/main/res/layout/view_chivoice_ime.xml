<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeRoot"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:background="@drawable/ime_paper_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/imeLanguageButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="普通话"
            android:textColor="@color/ime_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/imeStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="轻声落字"
            android:textColor="@color/ime_ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/imeHeaderAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="切换输入法"
            android:textColor="@color/ime_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/imePreviewText"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/ime_card_bg"
        android:gravity="top|start"
        android:padding="14dp"
        android:text="轻声落字，按住下方说话。"
        android:textColor="@color/ime_ink"
        android:textSize="14sp" />

    <com.example.voxa.ime.VoiceWaveformView
        android:id="@+id/imeWaveformView"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/imeMicButton"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/ime_circle_bg"
        android:gravity="center"
        android:text="按住\n说话"
        android:textAlignment="center"
        android:textColor="@color/ime_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/imeHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="支持实时预览，松开发送。"
        android:textColor="@color/ime_ink_soft"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/imePasteAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:text="粘贴"
            android:textColor="@color/ime_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/imePromptAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:text="打开 App"
            android:textColor="@color/ime_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/imeDeleteAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:text="退格"
            android:textColor="@color/ime_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/imeDoneAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/ime_pill_bg"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/ime_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
